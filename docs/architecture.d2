# Workspace packages and the core they share.
# Render: d2 docs/architecture.d2 docs/architecture.svg

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

direction: down

classes: {
  box: {
    style: {
      border-radius: 10
      font-size: 14
      font-color: "#1b2a41"
      stroke-width: 2
      shadow: true
    }
  }
  leaf: {
    style: {
      border-radius: 8
      font-size: 13
      font-color: "#1b2a41"
      stroke-width: 2
      shadow: true
    }
  }
}

style.fill: "#f6f4ef"
style.stroke: "#f6f4ef"

title: {
  label: nano-ui architecture
  near: top-center
  shape: text
  style: {
    font-size: 28
    bold: true
    font-color: "#1b2a41"
  }
}

app: "Application\nNanoUI DSL, optional typed reducer" {
  class: box
  style.fill: "#fffdf8"
  style.stroke: "#8a8174"
}

packages: Packages {
  class: box
  style.fill: "#ece7dc"
  style.stroke: "#8a8174"
  grid-columns: 3
  grid-gap: 40

  term: "nano-ui-term\nrunTermApp, CellHost\nrunFrame + DrawData" {
    class: box
    style.fill: "#dceee6"
    style.stroke: "#2d6a4f"
    direction: down

    t_session: Session { class: leaf; style.fill: "#fffdf8"; style.stroke: "#2d6a4f" }
    t_cells: Cells { class: leaf; style.fill: "#fffdf8"; style.stroke: "#2d6a4f" }
    t_driver: "Win32 / notcurses" { class: leaf; style.fill: "#fffdf8"; style.stroke: "#2d6a4f" }
    t_session -> t_cells -> t_driver
  }

  core: "nano-ui core" {
    class: box
    style.fill: "#dce6f2"
    style.stroke: "#3d5a80"
    grid-columns: 2
    grid-gap: 20

    api: "NanoUI\nwidgets, style, emit, ids" {
      class: leaf
      style.fill: "#f4f7fb"
      style.stroke: "#3d5a80"
    }
    frame: "Frame\nrunFrame, hit, focus, redraw" {
      class: leaf
      style.fill: "#c5d4e8"
      style.stroke: "#3d5a80"
    }
    widgets: "Widgets\nnode tree, chrome" {
      class: leaf
      style.fill: "#f4f7fb"
      style.stroke: "#3d5a80"
    }
    layout: "Layout\nSoA arena, two-pass flex" {
      class: leaf
      style.fill: "#f4f7fb"
      style.stroke: "#3d5a80"
    }
    draw: "Draw\nvertex arenas, DrawData" {
      class: leaf
      style.fill: "#f3ead8"
      style.stroke: "#9a6b2f"
    }
    state: "Context + Store\nids, anim, damage" {
      class: leaf
      style.fill: "#adc2dc"
      style.stroke: "#3d5a80"
    }
    test: "NanoUI.Testing\nheadless frames, ASCII" {
      class: leaf
      style.fill: "#f3ead8"
      style.stroke: "#9a6b2f"
    }

    api -> widgets
    widgets -> layout
    frame -> layout
    frame -> draw
    state -> frame
  }

  sdl: "nano-ui-sdl\nrunSdlApp, PixelHost\nrunFrame + DrawData" {
    class: box
    style.fill: "#dceee6"
    style.stroke: "#2d6a4f"
    direction: down

    s_window: "Window + atlas" { class: leaf; style.fill: "#fffdf8"; style.stroke: "#2d6a4f" }
    s_session: Session { class: leaf; style.fill: "#fffdf8"; style.stroke: "#2d6a4f" }
    s_batch: "C render batch" { class: leaf; style.fill: "#fffdf8"; style.stroke: "#2d6a4f" }
    s_window -> s_session -> s_batch
  }
}

app -> packages: defines UI
