packages:
  .
  term-lib
  sdl-lib

tests: True
benchmarks: True

package nano-ui
  optimization: 2
  ghc-options: -fspecialise-aggressively
  profiling-detail: late

package nano-ui-sdl
  optimization: 2
  profiling-detail: late

package nano-ui-term
  optimization: 2
  profiling-detail: late

package nano-ui-sdl-bench
  optimization: 2
  executable-static: True
