packages:
  packages/nano-ui
  packages/nano-ui-sdl
  packages/nano-ui-diagrams
  packages/nano-ui-demo
  packages/nano-ui-rgfw-bindings
  packages/nano-ui-rgfw
  packages/nano-ui-form
  ../ditto

tests: True
benchmarks: True

-- Packages build at Cabal's default -O1. On the headless frame profiler the
-- core at -O1 matches the runtime of the previous -O2 build while compiling
-- about twice as fast; add `optimization: 2` locally for release profiling.
package *
  profiling-detail: late

-- No specialisation, worker/wrapper, or field-unboxing flags: measured on the
-- headless frame profiler, -fspecialise-aggressively -flate-specialise
-- -fmax-worker-args=32 -funbox-strict-fields made the core ~12% slower at
-- runtime while adding compile time.
package nano-ui
  ghc-options: -Werror

package nano-ui-sdl
  flags: +sdl +simd
  ghc-options: -Werror

package nano-ui-demo
  flags: +sdl
  ghc-options: -Werror

-- Treat warnings as errors in development, without imposing that policy on
-- downstream builds of the published packages.
package nano-ui-diagrams
  ghc-options: -Werror

package nano-ui-form
  flags: +sdl
