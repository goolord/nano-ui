packages:
  packages/nano-ui
  packages/nano-ui-emit
  packages/nano-ui-ttf
  packages/nano-ui-sdl
  packages/nano-ui-sdl-web
  packages/nano-ui-diagrams
  packages/nano-ui-demo
  packages/nano-ui-rgfw-bindings
  packages/nano-ui-rgfw
  packages/nano-ui-form
  packages/nano-ui-markdown
  packages/nano-ui-svg

-- Pin the Hackage snapshot so a build resolves the same dependencies until
-- this line is moved forward on purpose.
index-state: hackage.haskell.org 2026-10-23T01:04:20Z

tests: True
benchmarks: True

-- Packages build at Cabal's default -O1 with no extra optimisation flags.
-- See book/src/getting-started/development.md ("Profiling") for profiling commands.
package *
  profiling-detail: late

-- -Werror is set here and not in the .cabal files, so warnings fail a
-- development build without failing a downstream build of a published package.
-- program-options applies to the local packages listed above, not to
-- dependencies.
program-options
  ghc-options: -Werror

-- The flags lines turn on the SDL backend and the executables that need it.
package nano-ui-ttf
  flags: +sdl

package nano-ui-sdl
  flags: +sdl

package nano-ui-sdl-web
  flags: +sdl

package nano-ui-demo
  flags: +sdl

package nano-ui-form
  flags: +sdl

package nano-ui-markdown
  flags: +sdl
