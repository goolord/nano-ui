packages:
  packages/nano-ui
  packages/nano-ui-sdl
  packages/nano-ui-diagrams
  packages/nano-ui-demo
  packages/nano-ui-rgfw-bindings
  packages/nano-ui-rgfw
  packages/nano-ui-form
  ../ditto

tests: True
benchmarks: True

-- Packages build at Cabal's default -O1 with no extra optimisation flags.
-- See docs/development.md ("Performance") for profiling commands.
package *
  profiling-detail: late

-- -Werror is set here and not in the .cabal files, so warnings fail a
-- development build without failing a downstream build of a published package.
-- The flags lines turn on the SDL backend, the executables that need it, and
-- the AVX2 batch culler (docs/development.md, "Flags").
package nano-ui
  ghc-options: -Werror

package nano-ui-sdl
  flags: +sdl +simd
  ghc-options: -Werror

package nano-ui-demo
  flags: +sdl
  ghc-options: -Werror

package nano-ui-diagrams
  ghc-options: -Werror

package nano-ui-form
  flags: +sdl
