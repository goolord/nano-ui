packages:
  packages/nano-ui
  packages/nano-ui-sdl
  packages/nano-ui-diagrams
  packages/nano-ui-demo
  packages/nano-ui-rgfw-bindings
  packages/nano-ui-rgfw
  packages/nano-ui-form
  ../ditto

tests: True
benchmarks: True

-- Packages build at Cabal's default -O1, and the optimisation flags below are
-- left off. docs/development.md ("Performance") has the measurements.
package *
  profiling-detail: late

package nano-ui
  ghc-options: -Werror

package nano-ui-sdl
  flags: +sdl +simd
  ghc-options: -Werror

package nano-ui-demo
  flags: +sdl
  ghc-options: -Werror

-- Treat warnings as errors in development, without imposing that policy on
-- downstream builds of the published packages.
package nano-ui-diagrams
  ghc-options: -Werror

package nano-ui-form
  flags: +sdl
