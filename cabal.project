packages:
  packages/nano-ui
  packages/nano-ui-term
  packages/nano-ui-sdl
  packages/nano-ui-diagrams
  packages/nano-ui-demo
  packages/nano-ui-rgfw-bindings
  packages/nano-ui-rgfw

tests: True
benchmarks: True

package *
  optimization: 2
  profiling-detail: late

package nano-ui
  ghc-options: -fspecialise-aggressively

package nano-ui-sdl
  executable-static: True

package nano-ui-rgfw-bindings
  ghc-options: -pgmc "C:/Users/zach/Dev/nano-ui/scripts/zig-cc.exe"
