cabal-version:      3.4
name:               nano-ui-emit
version:            0.1.0.0
synopsis:           Statically typed messages and reducers for nano-ui
description:        Typed emitting views, widget adapters, and headless reducer runners.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
homepage:           https://github.com/goolord/nano-ui
bug-reports:        https://github.com/goolord/nano-ui/issues
category:           Graphics
build-type:         Simple
tested-with:        GHC ==9.10.3 || ==9.14.1
extra-doc-files:    README.md CHANGELOG.md

source-repository head
    type:           git
    location:       https://github.com/goolord/nano-ui.git
    subdir:         packages/nano-ui-emit

common warnings
    ghc-options:
        -Wall
        -Wextra
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages

library
    import:           warnings
    default-language: GHC2024
    exposed-modules:
        NanoUI.Emit
        NanoUI.Emit.Widgets
    other-modules:
        NanoUI.Emit.Internal
    hs-source-dirs:   lib
    build-depends:
        base >=4.20 && <4.23,
        nano-ui ^>=0.2

test-suite nano-ui-emit-test
    import:           warnings
    type:             exitcode-stdio-1.0
    default-language: GHC2024
    default-extensions: OverloadedStrings
    main-is:          Main.hs
    other-modules:    DeferredWrongMessage
    hs-source-dirs:   test
    build-depends:
        base >=4.20 && <4.23,
        nano-ui,
        nano-ui-emit,
        text ^>=2.1
