cabal-version:      3.4
name:               nano-ui-emit
version:            0.1.0.0
synopsis:           Statically typed messages and reducers for nano-ui
description:        Typed emitting views, widget adapters, and headless reducer runners.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
homepage:           https://github.com/goolord/nano-ui
bug-reports:        https://github.com/goolord/nano-ui/issues
category:           Graphics
build-type:         Simple
tested-with:        GHC ==9.10.3 || ==9.14.1
extra-doc-files:    README.md CHANGELOG.md
extra-source-files: test/compile-fail/WrongMessage.hs

source-repository head
    type:           git
    location:       https://github.com/goolord/nano-ui.git
    subdir:         packages/nano-ui-emit

library
    default-language: GHC2024
    ghc-options:      -Wall -Wcompat -Wredundant-constraints
    exposed-modules:  NanoUI.Emit
    hs-source-dirs:   lib
    -- The library imports NanoUI.Internal modules, which change without
    -- notice, so it allows only nano-ui's 0.2.0.x patch releases.
    build-depends:
        base >=4.20 && <4.23,
        nano-ui >=0.2.0 && <0.2.1,
        transformers ^>=0.6

test-suite nano-ui-emit-test
    type:             exitcode-stdio-1.0
    default-language: GHC2024
    default-extensions: OverloadedStrings
    ghc-options:      -Wall -Wcompat -Wredundant-constraints
    main-is:          Main.hs
    other-modules:    DeferredWrongMessage
    hs-source-dirs:   test
    build-depends:
        base >=4.20 && <4.23,
        nano-ui,
        nano-ui-emit,
        text ^>=2.1
