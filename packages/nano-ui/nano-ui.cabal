cabal-version:      3.4
name:               nano-ui
version:            0.1.0.1
synopsis:           Immediate-mode GUI toolkit for Haskell
description:
    Widgets, layout, and input handling for immediate-mode interfaces. A view
    is a function that runs every frame, and widgets return what the user did.
    Pair it with a window backend such as nano-ui-sdl or nano-ui-rgfw.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
homepage:           https://github.com/goolord/nano-ui
bug-reports:        https://github.com/goolord/nano-ui/issues
category:           Graphics
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    GUIDE.md
    README.md

source-repository head
    type:     git
    location: https://github.com/goolord/nano-ui.git
    subdir:   packages/nano-ui

common extensions
    default-language: GHC2024
    default-extensions:
        DuplicateRecordFields
        MagicHash
        OverloadedStrings
        UnboxedTuples

common rts-options
    ghc-options:
        -rtsopts
        -threaded
        "-with-rtsopts=-N1 -A64m -T -I0"

common test-rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-A8m -H64m -K128m -T"

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

-- Tests, benchmarks and executables build against the library and also
-- reject dependencies they never import.
common downstream
    import:           extensions
    import:           warnings
    ghc-options:      -Wunused-packages
    build-depends:
        base ^>=4.22.0.0,
        nano-ui

library
    import:           extensions
    import:           warnings
    -- The public API is every exposed module outside NanoUI.Internal. The
    -- exposed NanoUI.Internal modules are for backends, tests and tools that
    -- need more than the API, and change without notice.
    exposed-modules:
        NanoUI
        NanoUI.Backend
        NanoUI.Bidi
        NanoUI.Emit
        NanoUI.Input
        NanoUI.Monad
        NanoUI.Runner
        NanoUI.Svg
        NanoUI.Testing
        NanoUI.Testing.Assert
        NanoUI.Testing.Harness
        NanoUI.Testing.Runner
        NanoUI.Widgets.Combo
        NanoUI.Widgets.Custom
        NanoUI.Widgets.PaneGrid
        NanoUI.Widgets.RichText
        NanoUI.Widgets.TextArea
        NanoUI.Widgets.TextBuffer
        NanoUI.Widgets.TextCommand
        NanoUI.Widgets.TextDocument
        NanoUI.Widgets.TextEditor
        NanoUI.Widgets.TextField
        NanoUI.Internal.Context
        NanoUI.Internal.Context.Types
        NanoUI.Internal.Debug
        NanoUI.Internal.Frame.Hit
        NanoUI.Internal.Frame.TextEdit
        NanoUI.Internal.Frame.Window
        NanoUI.Internal.Id
        NanoUI.Internal.Input
        NanoUI.Internal.Layout.Arena
        NanoUI.Internal.Layout.Solve
        NanoUI.Internal.Monad
        NanoUI.Internal.SIMD
        NanoUI.Internal.Store
        NanoUI.Internal.Widgets.Custom
        NanoUI.Internal.Widgets.SplitPane
        NanoUI.Internal.Widgets.TextArea
        NanoUI.Internal.Widgets.TextDocument
        NanoUI.Internal.Widgets.TextEditor
        NanoUI.Internal.Widgets.TextField
    other-modules:
        NanoUI.Internal.Animatable
        NanoUI.Internal.Animation
        NanoUI.Internal.Atlas
        NanoUI.Internal.Compact
        NanoUI.Internal.Context.Animation
        NanoUI.Internal.Context.Core
        NanoUI.Internal.Context.Drawing
        NanoUI.Internal.Context.Overlay
        NanoUI.Internal.Context.Scroll
        NanoUI.Internal.Damage
        NanoUI.Internal.Draw
        NanoUI.Internal.Font
        NanoUI.Internal.Hooks
        NanoUI.Internal.Frame
        NanoUI.Internal.Frame.Cursor
        NanoUI.Internal.Draw.Arena
        NanoUI.Internal.Draw.Shapes
        NanoUI.Internal.Draw.Types
        NanoUI.Internal.Frame.Input
        NanoUI.Internal.Frame.Chrome
        NanoUI.Internal.Frame.Focus
        NanoUI.Internal.Frame.Paint
        NanoUI.Internal.Frame.Paint.Widgets
        NanoUI.Internal.Frame.Redraw
        NanoUI.Internal.Frame.Scroll
        NanoUI.Internal.Frame.Scroll.Geometry
        NanoUI.Internal.Frame.Select
        NanoUI.Internal.Frame.Node
        NanoUI.Internal.Frame.Overlay
        NanoUI.Internal.Frame.Spans
        NanoUI.Internal.Frame.SpanArena
        NanoUI.Internal.Frame.TextArea
        NanoUI.Internal.Frame.TextArea.Content
        NanoUI.Internal.Frame.TextArea.Geometry
        NanoUI.Internal.Frame.TextEdit.Menu
        NanoUI.Internal.Frame.TextInput
        NanoUI.Internal.Style
        NanoUI.Internal.Types
        NanoUI.Internal.WidgetText
        NanoUI.Internal.Widgets.Node
        NanoUI.Internal.Widgets.Caption
        NanoUI.Internal.Widgets.Layout
        NanoUI.Internal.Widgets.Tabs
        NanoUI.Internal.Widgets.Radio
        NanoUI.Internal.Widgets.Tree
        NanoUI.Internal.Widgets.ColorPicker
        NanoUI.Internal.Widgets.Drawing
        NanoUI.Internal.Widgets.TextInput
        NanoUI.Internal.Widgets.NumericInput
        NanoUI.Internal.Widgets.TextCommon
        NanoUI.Internal.Widgets.Animate
        NanoUI.Internal.Widgets.Overlay
        NanoUI.Internal.Widgets.Popup
        NanoUI.Internal.Widgets.Menu
        NanoUI.Internal.Widgets.Table
        NanoUI.Internal.Widgets.Behavior
        NanoUI.Internal.Widgets.Combinators
        NanoUI.Internal.Widgets.Drop
        NanoUI.Internal.Widgets.Button
        NanoUI.Internal.Widgets.Checkbox
        NanoUI.Internal.Widgets.Display
        NanoUI.Internal.Widgets.Select
        NanoUI.Internal.Widgets.Slider
    build-depends:
        base ^>=4.22.0.0,
        bytestring ^>=0.12,
        colonnade ^>=1.2,
        containers ^>=0.8,
        effectful-core ^>=2.6,
        ghc-compact ^>=0.1,
        hashable ^>=1.5,
        hashtables ^>=1.4,
        nano-svg ^>=0.1,
        primitive ^>=0.9,
        text ^>=2.1,
        text-short ^>=0.1.6,
        transformers ^>=0.6,
        unordered-containers ^>=0.2,
        vector ^>=0.13
    hs-source-dirs:   lib

benchmark nano-ui-id-bench
    import:           downstream
    import:           test-rts-options
    type:             exitcode-stdio-1.0
    main-is:          IdBench.hs
    build-depends:
        tasty-bench ^>=0.4
    hs-source-dirs:   benchmark

test-suite text-buffer-spec
    import:           downstream
    type:             exitcode-stdio-1.0
    main-is:          NanoUI/TextBufferSpec.hs
    build-depends:
        hspec ^>=2.11,
        text ^>=2.1
    hs-source-dirs:   test

test-suite nano-ui-test
    import:           downstream
    import:           test-rts-options
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        Cases
        Spec
        Cases.Animation
        Cases.Caption
        Cases.Atlas
        Cases.Combo
        Cases.Damage
        Cases.Demo
        Cases.Grid
        Cases.HostDraw
        Cases.Keyboard
        Cases.Cache
        Cases.Runner
        Cases.RichText
        Cases.SIMD
        Cases.Shaping
        Cases.Styling
        Cases.Svg
        Cases.State
        Cases.Table
        Cases.Modal
        Cases.NoThunks
        Cases.Scroll
        Cases.Select
        Cases.Tabs
        Cases.TextInput
        Cases.NumericInput
        Cases.ContextMenu
        Cases.PointerOwnership
        Cases.PointerRelease
        Cases.CustomWidget
        Cases.Tooltip
        Cases.ViewApi
        Cases.Window
    build-depends:
        bytestring,
        containers,
        directory,
        effectful ^>=2.6,
        filepath,
        nothunks,
        primitive ^>=0.9,
        vector ^>=0.13,
        text ^>=2.1
    hs-source-dirs:   test/integration

executable nano-ui-profile
    import:           downstream
    import:           rts-options
    main-is:          Profile.hs
    hs-source-dirs:   examples
    build-depends:
        bytestring ^>=0.12,
        primitive ^>=0.9,
        text ^>=2.1

-- Compile-time verification of optimization invariants (inspection-testing).
-- Assertions fail the build if GHC stops inlining or starts allocating in the
-- checked bindings, converting silent performance regressions into errors.
test-suite nano-ui-inspection
    import:           downstream
    type:             exitcode-stdio-1.0
    main-is:          Inspection.hs
    ghc-options:      -fplugin=Test.Inspection.Plugin
    build-depends:
        containers,
        inspection-testing,
        primitive ^>=0.9,
        vector ^>=0.13,
        text ^>=2.1
    hs-source-dirs:   test/inspection
