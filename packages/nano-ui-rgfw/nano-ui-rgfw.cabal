cabal-version:      3.4
name:               nano-ui-rgfw
version:            0.1.0.0
synopsis:           RGFW and OpenGL window backend for nano-ui
description:
    Runs nano-ui views in a native window through RGFW and OpenGL 3.2, with
    the Cozette bitmap font bundled for text.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
homepage:           https://github.com/goolord/nano-ui
bug-reports:        https://github.com/goolord/nano-ui/issues
category:           Graphics
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

extra-source-files: data/cozette.min.otb

source-repository head
    type:     git
    location: https://github.com/goolord/nano-ui.git
    subdir:   packages/nano-ui-rgfw

common extensions
    default-language: GHC2024
    default-extensions:
        OverloadedStrings

common warnings
    ghc-options:
        -Wall
        -Wextra
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages

library
    import:           extensions
    import:           warnings
    exposed-modules:
        NanoUI.Backend.Rgfw
        NanoUI.Rgfw.Internal.Context
        NanoUI.Rgfw.Internal.Debug
        NanoUI.Rgfw.Internal.Font.Cozette
        NanoUI.Rgfw.Internal.Gl
        NanoUI.Rgfw.Internal.Session
    c-sources:        cbits/nano_ui_gl.c
    build-depends:
        base ^>=4.22.0.0,
        bytestring ^>=0.12,
        effectful-core ^>=2.6,
        file-embed ^>=0.0.16,
        nano-ui-rgfw-bindings ^>=0.1,
        nano-ui ^>=0.1,
        primitive ^>=0.9,
        text ^>=2.1
    hs-source-dirs:   lib

executable nano-ui-rgfw-demo
    import:           extensions
    import:           warnings
    main-is:          RgfwDemo.hs
    other-modules:    RgfwDemoCommon
    build-depends:
        base ^>=4.22.0.0,
        nano-ui,
        nano-ui-rgfw,
        text ^>=2.1
    hs-source-dirs:   examples

executable nano-ui-rgfw-profile
    import:           extensions
    import:           warnings
    main-is:          RgfwProfile.hs
    other-modules:    RgfwDemoCommon
    build-depends:
        base ^>=4.22.0.0,
        nano-ui,
        nano-ui-rgfw,
        nano-ui-rgfw-bindings,
        text ^>=2.1
    hs-source-dirs:   examples

test-suite nano-ui-rgfw-test
    import:           extensions
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:
        NanoUI.Rgfw.Render
        NanoUI.Rgfw.Surface
    build-depends:
        base ^>=4.22.0.0,
        nano-ui,
        nano-ui-rgfw,
        nano-ui-rgfw-bindings,
        primitive ^>=0.9,
        vector ^>=0.13,
        text ^>=2.1
    hs-source-dirs:   test
