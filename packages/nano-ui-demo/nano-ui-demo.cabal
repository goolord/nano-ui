cabal-version:      3.4
name:               nano-ui-demo
version:            0.1.0.0
synopsis:           Example applications for nano-ui
description:
    SDL3 examples for nano-ui: a widget tour, a text editor, a log viewer, and
    a terminal.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
homepage:           https://github.com/goolord/nano-ui
bug-reports:        https://github.com/goolord/nano-ui/issues
category:           Graphics
build-type:         Simple
extra-doc-files:
    README.md
data-files:
    data/lick.gif
    data/icons/*.svg

source-repository head
    type:     git
    location: https://github.com/goolord/nano-ui.git
    subdir:   packages/nano-ui-demo

flag sdl
    description: Build the SDL3 demos. Needs SDL3, SDL3_ttf, and pkg-config.
    manual: True
    default: True

common extensions
    default-language: GHC2024
    default-extensions:
        DuplicateRecordFields
        OverloadedStrings

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

common rts-options
    ghc-options:
        -rtsopts
        -threaded
        "-with-rtsopts=-N1 -A64m -T -I0"

-- Every component needs the SDL backend.
common sdl-app
    import:           extensions
    import:           warnings
    build-depends:    base ^>=4.22.0.0
    if !flag(sdl)
        buildable: False

common sdl-exe
    import:           sdl-app
    import:           rts-options
    hs-source-dirs:   app
    if os(windows)
        ghc-options: -optl-mconsole

-- Modules shared by the executables and the terminal test, compiled once.
library demo-common
    import:           sdl-app
    visibility:       private
    hs-source-dirs:   lib
    exposed-modules:
        DemoApp
        DemoData
        SdlDemo
        SdlRecord
        SdlSelftest
    other-modules:    Paths_nano_ui_demo
    autogen-modules:  Paths_nano_ui_demo
    build-depends:
        bytestring ^>=0.12,
        diagrams-lib >=1.6 && <1.7,
        filepath ^>=1.5,
        JuicyPixels ^>=3.3,
        nano-ui ^>=0.1,
        nano-ui-diagrams ^>=0.1,
        nano-ui-sdl ^>=0.1,
        primitive ^>=0.9,
        text ^>=2.1,
        vector ^>=0.13
    if !os(windows)
        exposed-modules:  SdlTerminal
        c-sources:        cbits/terminal-size.c
        build-depends:
            streaming ^>=0.2,
            unix ^>=2.8

executable nano-ui-sdl-demo
    import:           sdl-exe
    main-is:          Demo.hs
    build-depends:    nano-ui-demo:demo-common

executable nano-ui-sdl-profile
    import:           sdl-exe
    main-is:          Profile.hs
    build-depends:
        nano-ui ^>=0.1,
        nano-ui-demo:demo-common,
        nano-ui-diagrams ^>=0.1,
        nano-ui-sdl ^>=0.1,
        primitive ^>=0.9,
        text ^>=2.1

executable nano-ui-sdl-notepad
    import:           sdl-exe
    main-is:          Notepad.hs
    build-depends:
        bytestring ^>=0.12,
        nano-ui ^>=0.1,
        nano-ui-demo:demo-common,
        nano-ui-sdl ^>=0.1,
        text ^>=2.1

executable nano-ui-sdl-logs
    import:           sdl-exe
    main-is:          Logs.hs
    build-depends:
        nano-ui ^>=0.1,
        nano-ui-sdl ^>=0.1,
        text ^>=2.1,
        vector ^>=0.13

executable nano-ui-sdl-terminal
    import:           sdl-exe
    main-is:          Terminal.hs
    build-depends:    nano-ui-demo:demo-common
    if os(windows)
        buildable: False

test-suite nano-ui-terminal-test
    import:           sdl-app
    import:           rts-options
    type:             exitcode-stdio-1.0
    main-is:          TerminalTest.hs
    hs-source-dirs:   test
    build-depends:
        bytestring ^>=0.12,
        nano-ui-demo:demo-common,
        streaming ^>=0.2,
        text ^>=2.1,
        vector ^>=0.13
    if os(windows)
        buildable: False
