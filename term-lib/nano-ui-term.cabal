cabal-version:      3.4
name:               nano-ui-term
version:            0.1.0.0
synopsis:           Terminal backend for nano-ui
description:        Cell-grid host for nano-ui. Win32 console on Windows, notcurses elsewhere.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
category:           Graphics
build-type:         Simple

flag notcurses
    description: POSIX notcurses backend for the TUI. Not required for SDL or Windows.
    manual: True
    default: False

common extensions
    default-language: GHC2024
    default-extensions:
        BangPatterns
        DeriveGeneric
        DuplicateRecordFields
        FlexibleContexts
        GeneralizedNewtypeDeriving
        MagicHash
        OverloadedStrings
        ScopedTypeVariables
        UnboxedTuples

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options:
        -rtsopts
        -threaded
        "-with-rtsopts=-N --nonmoving-gc -qb0 -T -I0"

common test-rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-A8m -H64m -K128m -T"

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
    import:           extensions
    import:           warnings
    exposed-modules:
        NanoUI.Backend.Term
        NanoUI.Testing.Term
    other-modules:
        NanoUI.Term.Session
        NanoUI.Term.Debug
        NanoUI.Term.Icons
        NanoUI.Term.Palette
        NanoUI.Term.Ansi
        NanoUI.Term.Cells
        NanoUI.Term.Event
        NanoUI.Term.Vt
    build-depends:
        base ^>=4.22.0.0,
        bytestring,
        effectful ^>=2.6,
        nano-ui,
        primitive ^>=0.9,
        text ^>=2.1
    hs-source-dirs:   .
    default-language: GHC2024
    if os(windows)
        build-depends: Win32 >=2.14
        other-modules:
            NanoUI.Term.Driver
            NanoUI.Term.Driver.Types
            NanoUI.Term.Driver.Windows
    elif flag(notcurses)
        c-sources:        cbits/nano_ui_notcurses.c
        include-dirs:     cbits
        pkgconfig-depends: notcurses-core >= 3.0
        other-modules:    NanoUI.Term.Notcurses
    else
        buildable: False

executable nano-ui-tui
    import:           extensions
    import:           rts-options
    import:           warnings
    main-is:          Tui.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui,
        nano-ui-term,
        text ^>=2.1
    hs-source-dirs:   examples
    default-language: GHC2024
    if !os(windows) && !flag(notcurses)
        buildable: False

test-suite nano-ui-term-test
    import:           extensions
    import:           test-rts-options
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        ApiBoundary
        Cases
        Cases.Terminal
        Cases.TermCells
    build-depends:
        base ^>=4.22.0.0,
        bytestring,
        effectful ^>=2.6,
        nano-ui,
        nano-ui-term,
        text ^>=2.1
    hs-source-dirs:   test
    default-language: GHC2024
    if !os(windows) && !flag(notcurses)
        buildable: False
