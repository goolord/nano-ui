-- The browser build: nano-ui, the web backend and the browser sampler for
-- wasm32-wasi, with GHC's wasm backend (ghc-wasm-meta). Build with
-- packages/nano-ui-sdl-web/scripts/build-web.sh, which passes this file as
-- --project-file. SDL3 and SDL3_ttf come from build-wasi-deps.sh through
-- PKG_CONFIG_PATH.
packages:
  packages/nano-ui
  packages/nano-ui-emit
  packages/nano-ui-ttf
  packages/nano-ui-sdl-web
  packages/nano-ui-diagrams
  packages/nano-ui-demo

-- The Hackage snapshot cabal.project pins.
index-state: hackage.haskell.org 2026-10-23T01:04:20Z

tests: False
benchmarks: False

-- A page downloads the whole module, so the linker should drop what the
-- program does not reach. Without this GHC links a module's code whenever
-- one of its bindings is used; with a section for each binding, only the
-- bindings that are reached. It applies to the dependencies built here too.
package *
  split-sections: True

package nano-ui-ttf
  flags: +sdl

package nano-ui-sdl-web
  flags: +sdl

-- Only the browser sampler: the SDL demos and their libraries need
-- nano-ui-sdl, which has no browser build.
package nano-ui-demo
  flags: -sdl +web
