-- The browser build: nano-ui and the web backend for wasm32-wasi, with
-- GHC's wasm backend (ghc-wasm-meta). Build with
-- packages/nano-ui-sdl-web/scripts/build-web.sh, which passes this file as
-- --project-file. SDL3 and SDL3_ttf come from build-wasi-deps.sh through
-- PKG_CONFIG_PATH.
packages:
  packages/nano-ui
  packages/nano-ui-emit
  packages/nano-ui-ttf
  packages/nano-ui-sdl-web

-- The Hackage snapshot cabal.project pins.
index-state: hackage.haskell.org 2026-10-23T01:04:20Z

tests: False
benchmarks: False

package nano-ui-ttf
  flags: +sdl

package nano-ui-sdl-web
  flags: +sdl
