cabal-version:      3.4
name:               nano-ui
version:            0.1.0.0
synopsis:           Purely functional immediate-mode GUI core for Haskell
description:        Backend-agnostic IMGUI library with SrcLoc IDs, two-pass flex layout,
                    pinned vertex arenas, and damage-tracked idle rendering.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
category:           Graphics
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

common extensions
    default-language: GHC2021
    default-extensions:
        BangPatterns
        DeriveGeneric
        FlexibleContexts
        GeneralizedNewtypeDeriving
        MagicHash
        OverloadedStrings
        ScopedTypeVariables
        UnboxedTuples

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options:
        -rtsopts
        -threaded
        "-with-rtsopts=-N --nonmoving-gc -qb0 -T -I0"

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
    import:           extensions
    import:           ghc-options
    import:           warnings
    exposed-modules:
        NanoUI
    other-modules:
        NanoUI.Animatable
        NanoUI.Atlas
        NanoUI.Compact
        NanoUI.Context
        NanoUI.Draw
        NanoUI.Ease
        NanoUI.Font
        NanoUI.Frame
        NanoUI.Host
        NanoUI.Icons
        NanoUI.Id
        NanoUI.Input
        NanoUI.Layout.Arena
        NanoUI.Layout.Solve
        NanoUI.Monad
        NanoUI.Render.ASCII
        NanoUI.Spring
        NanoUI.Style
        NanoUI.Types
        NanoUI.WidgetText
        NanoUI.Widgets
    build-depends:
        base ^>=4.22.0.0,
        bytestring ^>=0.12,
        containers ^>=0.8,
        effectful ^>=2.6,
        effectful-core ^>=2.6,
        ghc-compact ^>=0.1,
        hashable ^>=1.5,
        primitive ^>=0.9,
        text ^>=2.1
    hs-source-dirs:   lib
    default-language: GHC2024

executable nano-ui-demo
    import:           extensions
    import:           ghc-options
    import:           rts-options
    import:           warnings
    main-is:          Demo.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui
    hs-source-dirs:   examples
    default-language: GHC2024

executable nano-ui-profile
    import:           extensions
    import:           ghc-options
    import:           rts-options
    import:           warnings
    main-is:          Profile.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui
    hs-source-dirs:   examples
    default-language: GHC2024
