cabal-version:      3.4
name:               nano-ui
version:            0.1.0.0
synopsis:           Purely functional immediate-mode GUI core for Haskell
description:        Backend-agnostic IMGUI library with topological path IDs, two-pass flex layout,
                    pinned vertex arenas, and damage-tracked idle rendering.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
category:           Graphics
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

common extensions
    default-language: GHC2021
    default-extensions:
        BangPatterns
        DeriveGeneric
        DuplicateRecordFields
        FlexibleContexts
        GeneralizedNewtypeDeriving
        MagicHash
        OverloadedStrings
        ScopedTypeVariables
        UnboxedTuples

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options:
        -rtsopts
        -threaded
        "-with-rtsopts=-N --nonmoving-gc -qb0 -T -I0"

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
    import:           extensions
    import:           ghc-options
    import:           warnings
    exposed-modules:
        NanoUI
        NanoUI.Testing
    other-modules:
        NanoUI.Animatable
        NanoUI.Animation
        NanoUI.Atlas
        NanoUI.ColorPicker
        NanoUI.Compact
        NanoUI.Context
        NanoUI.Context.Types
        NanoUI.Context.Animation
        NanoUI.Context.Internal
        NanoUI.Context.Modal
        NanoUI.Context.Tooltip
        NanoUI.Context.Atlas
        NanoUI.Context.PrevRects
        NanoUI.Context.Store
        NanoUI.Context.Config
        NanoUI.Context.Dirty
        NanoUI.Context.Host
        NanoUI.Context.Focus
        NanoUI.Context.Messages
        NanoUI.Context.New
        NanoUI.Damage
        NanoUI.Draw
        NanoUI.Ease
        NanoUI.Font
        NanoUI.Frame
        NanoUI.Frame.Cursor
        NanoUI.Frame.CursorKind
        NanoUI.Frame.Input
        NanoUI.Frame.Clip
        NanoUI.Frame.Chrome
        NanoUI.Frame.Focus
        NanoUI.Frame.Hit
        NanoUI.Frame.Internal
        NanoUI.Frame.Paint
        NanoUI.Frame.Redraw
        NanoUI.Frame.Scroll
        NanoUI.Frame.Select
        NanoUI.Frame.Spans
        NanoUI.Frame.SpanArena
        NanoUI.Frame.TextInput
        NanoUI.Frame.Window
        NanoUI.Host
        NanoUI.Icons
        NanoUI.Id
        NanoUI.Input
        NanoUI.Layout.Arena
        NanoUI.Layout.Solve
        NanoUI.Messages
        NanoUI.Monad
        NanoUI.Render.ASCII
        NanoUI.Spring
        NanoUI.Store
        NanoUI.Style
        NanoUI.Types
        NanoUI.WidgetText
        NanoUI.Widgets
        NanoUI.Widgets.Internal
        NanoUI.Widgets.Node
        NanoUI.Widgets.Chrome
        NanoUI.Widgets.Layout
        NanoUI.Widgets.Tabs
        NanoUI.Widgets.Radio
        NanoUI.Widgets.Tree
        NanoUI.Widgets.ColorPicker
        NanoUI.Widgets.TextInput
        NanoUI.Widgets.Animate
        NanoUI.Widgets.Overlay
        NanoUI.Widgets.Table
    build-depends:
        base ^>=4.22.0.0,
        bytestring ^>=0.12,
        colonnade ^>=1.2,
        containers ^>=0.8,
        effectful ^>=2.6,
        effectful-core ^>=2.6,
        ghc-compact ^>=0.1,
        hashable ^>=1.5,
        hashtables ^>=1.4,
        primitive ^>=0.9,
        text ^>=2.1,
        unordered-containers ^>=0.2,
        vector ^>=0.13
    hs-source-dirs:   lib
    default-language: GHC2024

benchmark nano-ui-id-bench
    import:           extensions
    import:           ghc-options
    import:           rts-options
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          IdBench.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui,
        tasty-bench ^>=0.4
    hs-source-dirs:   benchmark
    default-language: GHC2024

executable nano-ui-demo
    import:           extensions
    import:           ghc-options
    import:           rts-options
    import:           warnings
    main-is:          Demo.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui,
        text ^>=2.1
    hs-source-dirs:   examples
    default-language: GHC2024

executable nano-ui-profile
    import:           extensions
    import:           ghc-options
    import:           rts-options
    import:           warnings
    main-is:          Profile.hs
    hs-source-dirs:   examples
    build-depends:
        base ^>=4.22.0.0,
        bytestring ^>=0.12,
        containers ^>=0.8,
        effectful-core ^>=2.6,
        nano-ui,
        text ^>=2.1,
        vector ^>=0.13
    default-language: GHC2024
