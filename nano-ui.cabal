cabal-version:      3.4
name:               nano-ui
version:            0.1.0.0
synopsis:           Purely functional immediate-mode GUI core for Haskell
description:        Backend-agnostic IMGUI library with SrcLoc IDs, two-pass flex layout,
                    pinned vertex arenas, and damage-tracked idle rendering.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
category:           Graphics
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

flag sdl
    description: Build the SDL3 window backend (requires SDL3, SDL3_ttf, and pkg-config)
    manual: True
    default: False

common extensions
    default-language: GHC2021
    default-extensions:
        BangPatterns
        DeriveGeneric
        FlexibleContexts
        GeneralizedNewtypeDeriving
        MagicHash
        OverloadedStrings
        ScopedTypeVariables
        UnboxedTuples

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options:
        -rtsopts
        -threaded
        "-with-rtsopts=-N --nonmoving-gc -qb0 -T -I0"

common test-rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-A8m -H64m"

-- -N1 keeps the threaded runtime on one capability. Do not pass tasty's -j1
-- via -with-rtsopts; use: cabal bench ... --benchmark-options=-j1
common bench-rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-N1 -T"

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
    import:           extensions
    import:           ghc-options
    import:           warnings
    exposed-modules:
        NanoUI
    other-modules:
        NanoUI.Atlas
        NanoUI.Compact
        NanoUI.Context
        NanoUI.Draw
        NanoUI.Font
        NanoUI.Frame
        NanoUI.Id
        NanoUI.Input
        NanoUI.Layout.Arena
        NanoUI.Layout.Solve
        NanoUI.Monad
        NanoUI.Render.ASCII
        NanoUI.Style
        NanoUI.Types
        NanoUI.WidgetText
        NanoUI.Widgets
    build-depends:
        base ^>=4.22.0.0,
        bytestring ^>=0.12,
        containers ^>=0.8,
        effectful ^>=2.6,
        effectful-core ^>=2.6,
        ghc-compact ^>=0.1,
        hashable ^>=1.5,
        primitive ^>=0.9,
        text ^>=2.1
    hs-source-dirs:   lib
    default-language: GHC2024

executable nano-ui-demo
    import:           extensions
    import:           ghc-options
    import:           rts-options
    import:           warnings
    main-is:          Demo.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui
    hs-source-dirs:   examples
    default-language: GHC2024

executable nano-ui-profile
    import:           extensions
    import:           ghc-options
    import:           rts-options
    import:           warnings
    main-is:          Profile.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui
    hs-source-dirs:   examples
    default-language: GHC2024

-- Terminal backend: Win32 console on Windows, notcurses elsewhere.
library nano-ui-term
    import:           extensions
    import:           ghc-options
    import:           warnings
    exposed-modules:
        NanoUI.Backend.Term
        NanoUI.Term.Ansi
        NanoUI.Term.Cells
        NanoUI.Term.Event
        NanoUI.Term.Vt
    build-depends:
        base ^>=4.22.0.0,
        bytestring,
        nano-ui,
        primitive ^>=0.9,
        text ^>=2.1
    hs-source-dirs:   term-lib
    default-language: GHC2024
    if os(windows)
        build-depends: Win32 >=2.14
        other-modules:
            NanoUI.Term.Driver
            NanoUI.Term.Driver.Types
            NanoUI.Term.Driver.Windows
    else
        c-sources:        term-lib/cbits/nano_ui_notcurses.c
        include-dirs:     term-lib/cbits
        pkgconfig-depends: notcurses-core >= 3.0
        other-modules:    NanoUI.Term.Notcurses

executable nano-ui-tui
    import:           extensions
    import:           ghc-options
    import:           rts-options
    import:           warnings
    main-is:          Tui.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui,
        nano-ui:nano-ui-term,
        text ^>=2.1
    hs-source-dirs:   examples
    default-language: GHC2024

library nano-ui-sdl
    import:           extensions
    import:           ghc-options
    import:           warnings
    exposed-modules:
        NanoUI.Backend.Sdl
        NanoUI.Sdl.Event
    other-modules:
        NanoUI.Sdl.Batch
        NanoUI.Sdl.Clipboard
        NanoUI.Sdl.Cursor
        NanoUI.Sdl.Debug
        NanoUI.Sdl.Display
        NanoUI.Sdl.Font
        NanoUI.Sdl.Image
        NanoUI.Sdl.Input
        NanoUI.Sdl.Render
        NanoUI.Sdl.Shape
        NanoUI.Sdl.Window
    build-depends:
        base ^>=4.22.0.0,
        bytestring ^>=0.12,
        containers ^>=0.8,
        directory ^>=1.3,
        nano-ui,
        record-hasfield ^>=1.0,
        sdl3-bindgen-sys ^>=0.0.0.2,
        text ^>=2.1
    hs-source-dirs:   sdl-lib
    default-language: GHC2024
    if flag(sdl)
        c-sources:        sdl-lib/cbits/nano_ui_ttf.c
                          sdl-lib/cbits/nano_ui_display.c
                          sdl-lib/cbits/nano_ui_image.c
                          sdl-lib/cbits/nano_ui_batch.c
                          sdl-lib/cbits/nano_ui_text_atlas.c
        include-dirs:     sdl-lib/cbits
        pkgconfig-depends: sdl3 >= 3.2, sdl3-ttf >= 3.2
    else
        buildable: False

executable nano-ui-sdl-demo
    import:           extensions
    import:           ghc-options
    import:           rts-options
    import:           warnings
    main-is:          SdlDemo.hs
    other-modules:    SdlDemoUi
    build-depends:
        base ^>=4.22.0.0,
        bytestring ^>=0.12,
        nano-ui,
        nano-ui:nano-ui-sdl,
        text ^>=2.1
    hs-source-dirs:   examples
    default-language: GHC2024
    if !flag(sdl)
        buildable: False

executable nano-ui-sdl-profile
    import:           extensions
    import:           ghc-options
    import:           bench-rts-options
    import:           warnings
    main-is:          SdlProfile.hs
    other-modules:    SdlDemoUi
    build-depends:
        base ^>=4.22.0.0,
        bytestring ^>=0.12,
        nano-ui,
        nano-ui:nano-ui-sdl,
        text ^>=2.1
    hs-source-dirs:   examples
    default-language: GHC2024
    if os(windows)
        ghc-options: -optl-mconsole
    if !flag(sdl)
        buildable: False

test-suite nano-ui-test
    import:           extensions
    import:           ghc-options
    import:           test-rts-options
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    build-depends:
        base ^>=4.22.0.0,
        bytestring,
        effectful ^>=2.6,
        nano-ui,
        nano-ui:nano-ui-term,
        text ^>=2.1
    hs-source-dirs:   test
    default-language: GHC2024

benchmark nano-ui-sdl-bench
    import:           extensions
    import:           ghc-options
    import:           bench-rts-options
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          SdlBench.hs
    build-depends:
        base ^>=4.22.0.0,
        tasty-bench ^>=0.5,
        nano-ui,
        nano-ui:nano-ui-sdl,
        text ^>=2.1
    hs-source-dirs:   benchmark
    default-language: GHC2024
    default-extensions: CPP
    if flag(sdl)
        pkgconfig-depends: sdl3 >= 3.2, sdl3-ttf >= 3.2
    if os(windows)
        build-depends: Win32 >=2.14
        cpp-options: -Dmingw32_HOST_OS
        -- Static SDL pkg-config adds -mwindows; keep a console for tasty output.
        ghc-options: -optl-mconsole
    if !flag(sdl)
        buildable: False
