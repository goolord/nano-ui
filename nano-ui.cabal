cabal-version:      3.4
name:               nano-ui
version:            0.1.0.0
synopsis:           Purely functional immediate-mode GUI core for Haskell
description:        Backend-agnostic IMGUI library with SrcLoc IDs, two-pass flex layout,
                    pinned vertex arenas, and damage-tracked idle rendering.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
category:           Graphics
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

common extensions
    default-language: GHC2021
    default-extensions:
        BangPatterns
        DeriveGeneric
        FlexibleContexts
        GeneralizedNewtypeDeriving
        MagicHash
        OverloadedStrings
        ScopedTypeVariables
        UnboxedTuples

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options:
        -rtsopts
        -threaded
        "-with-rtsopts=-N --nonmoving-gc -qb0"

common test-rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-A8m -H64m"

library
    import:           extensions
    import:           ghc-options
    exposed-modules:
        NanoUI
    other-modules:
        NanoUI.Context
        NanoUI.Draw
        NanoUI.Font
        NanoUI.Frame
        NanoUI.Id
        NanoUI.Input
        NanoUI.Layout.Arena
        NanoUI.Layout.Solve
        NanoUI.Monad
        NanoUI.Render.ASCII
        NanoUI.Style
        NanoUI.Types
        NanoUI.Widgets
    build-depends:
        base ^>=4.22.0.0,
        containers ^>=0.8,
        hashable ^>=1.5,
        primitive ^>=0.9,
        text ^>=2.1
    hs-source-dirs:   lib
    default-language: GHC2024

executable nano-ui-demo
    import:           extensions
    import:           ghc-options
    import:           rts-options
    main-is:          Demo.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui
    hs-source-dirs:   examples
    default-language: GHC2024

test-suite nano-ui-test
    import:           extensions
    import:           ghc-options
    import:           test-rts-options
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    build-depends:
        base ^>=4.22.0.0,
        nano-ui
    hs-source-dirs:   test
    default-language: GHC2024
